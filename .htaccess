# mod_rewrite エンジンを有効化
RewriteEngine On

# サーバー上のベースディレクトリを指定
RewriteBase /ryusei/

# ----------------------------------------------------
# 0. 特定のクエリ文字列を恒久削除 (410 GONE) にする
# ----------------------------------------------------
# InterWikiName.html
RewriteCond %{QUERY_STRING} ^InterWikiName\.html$
RewriteRule ^$ - [G,L]

# PHP.html
RewriteCond %{QUERY_STRING} ^PHP\.html$
RewriteRule ^$ - [G,L]


# ----------------------------------------------------
# 1. 複雑な置換（次回作妄想）への個別対応 - **キャプチャグループでデコード処理**
# ----------------------------------------------------
# 元クエリ: 次回作妄想/第2回+カード選択編.html
# パターン: %1 (次回作妄想) / %2 (第2回) + %3 (カード選択編)
# キャプチャグループを利用し、リダイレクト先をデコードされた日本語で記述
RewriteCond %{QUERY_STRING} ^(%E6%AC%A1%E5%9B%9E%E4%BD%9C%E5%A6%84%E6%83%B3)/(.+?)%2B(.+?)\.html$
# リダイレクト先: docs/%1/%1-%2-%3/ (エンコードされたキャプチャグループとデコードされたハイフン、日本語)
RewriteRule ^$ docs/%1/%1-%2-%3/ [R=301,NE,QSD,L]


# ----------------------------------------------------
# 2. 特殊文字の置換が必要なケース（ストーリー攻略の〜 と ・ を - に置換）
#    -> パターン: %1 (ストーリー攻略/第X話) %EF%BD%9E(.+?)%E3%83%BB(.+?)\.html
#    -> 置換先: docs/%1-%2-%3/
# ----------------------------------------------------

# **第1話〜オックス・ファイア戦.html**
RewriteCond %{QUERY_STRING} ^(%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AA%E3%83%BC%E6%94%BB%E7%95%A5/%E7%AC%AC1%E8%A9%B1)%EF%BD%9E(.+?)%E3%83%BB(.+?)\.html$
RewriteRule ^$ docs/%1-%2-%3/ [R=301,NE,QSD,L]

# **第5話〜オヒュカス・クイーン戦.html**
RewriteCond %{QUERY_STRING} ^(%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AA%E3%83%BC%E6%94%BB%E7%95%A5/%E7%AC%AC5%E8%A9%B1)%EF%BD%9E(.+?)%E3%83%BB(.+?)\.html$
RewriteRule ^$ docs/%1-%2-%3/ [R=301,NE,QSD,L]

# **第6話〜ジェミニ・スパーク戦.html**
RewriteCond %{QUERY_STRING} ^(%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AA%E3%83%BC%E6%94%BB%E7%95%A5/%E7%AC%AC6%E8%A9%B1)%EF%BD%9E(.+?)%E3%83%BB(.+?)\.html$
RewriteRule ^$ docs/%1-%2-%3/ [R=301,NE,QSD,L]


# ----------------------------------------------------
# 3. 通常のURL（.htmlで終わり、上記置換ルールにマッチしないもの）を /docs/ にリダイレクト
# ----------------------------------------------------
RewriteCond %{QUERY_STRING} ^(.+?)\.html$
RewriteRule ^$ docs/%1/ [R=301,NE,QSD,L]

